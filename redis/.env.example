# Redis Environment Configuration
# Copy this file to .env.dev or .env.prod and adjust values accordingly.
# Usage:
#   docker compose --env-file .env.dev up -d
#   docker compose --env-file .env.prod up -d

# ─── Credentials ─────────────────────────────────────────────────────────────
# dev: simple password | prod: long random secret
REDIS_PASSWORD=change-me-use-a-long-random-secret

# ─── Bind Address ────────────────────────────────────────────────────────────
# dev: 127.0.0.1 (localhost only)
# prod: 0.0.0.0 (all interfaces, behind reverse proxy)
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_INSIGHT_BIND_ADDRESS=127.0.0.1

# ─── Resource Limits ─────────────────────────────────────────────────────────
# dev: 128mb | prod: sesuai kebutuhan (256mb, 512mb, dst)
REDIS_MAX_MEMORY=128mb
# dev: 256m | prod: sesuai kebutuhan
REDIS_MEM_LIMIT=256m

# ─── Restart Policy ─────────────────────────────────────────────────────────
# dev: no | prod: unless-stopped
RESTART_POLICY=no
