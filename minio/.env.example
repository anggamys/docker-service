# MinIO Environment Configuration
# Copy this file to .env.dev or .env.prod and adjust values accordingly.
# Usage:
#   docker compose --env-file .env.dev up -d
#   docker compose --env-file .env.prod up -d

# ─── Credentials ────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
# dev: simple password | prod: long random secret
MINIO_ROOT_PASSWORD=change-me-use-a-long-random-secret

# ─── Prometheus ─────────────────────────────────────────────────────────────
MINIO_PROMETHEUS_AUTH_TYPE=public

# ─── Bind Address ───────────────────────────────────────────────────────────
# dev: 127.0.0.1 (localhost only)
# prod: 0.0.0.0 (all interfaces, behind reverse proxy)
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_CONSOLE_BIND_ADDRESS=127.0.0.1

# ─── Timezone ───────────────────────────────────────────────────────────────
TZ=Asia/Jakarta

# ─── Restart Policy ─────────────────────────────────────────────────────────
# dev: no | prod: unless-stopped
RESTART_POLICY=no
