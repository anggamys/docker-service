# MySQL + phpMyAdmin Environment Configuration
# Copy this file to .env.dev or .env.prod and adjust values accordingly.
# Usage:
#   docker compose --env-file .env.dev up -d
#   docker compose --env-file .env.prod up -d

# ─── MySQL ───────────────────────────────────────────────────────────────────
# dev: simple password | prod: long random secret
MYSQL_ROOT_PASSWORD=change-me-use-a-long-random-secret
MYSQL_USER=dev
# dev: simple password | prod: long random secret
MYSQL_PASSWORD=change-me-use-a-long-random-secret
# dev: app_dev | prod: app_prod
MYSQL_DATABASE=app_dev
# dev: 127.0.0.1 | prod: 0.0.0.0
MYSQL_BIND_ADDRESS=127.0.0.1

# ─── phpMyAdmin ──────────────────────────────────────────────────────────────
# dev: 127.0.0.1 | prod: 0.0.0.0 (behind reverse proxy)
PHPMYADMIN_BIND_ADDRESS=127.0.0.1

# ─── Timezone ────────────────────────────────────────────────────────────────
TZ=Asia/Jakarta

# ─── MySQL Exporter ──────────────────────────────────────────────────────────
MYSQL_EXPORTER_USER=mysqld_exporter
# dev: simple password | prod: long random secret
MYSQL_EXPORTER_PASS=change-me-use-a-long-random-secret
