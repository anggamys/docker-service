# Vault Environment Configuration
# Copy this file to .env.dev or .env.prod and adjust values accordingly.
# Usage:
#   docker compose --env-file .env.dev up -d
#   docker compose --env-file .env.prod up -d

# ─── Vault Version ───────────────────────────────────────────────────────────
VAULT_VERSION=1.18

# ─── Bind Address ────────────────────────────────────────────────────────────
# dev: 127.0.0.1 (localhost only)
# prod: 0.0.0.0 (all interfaces, behind reverse proxy)
VAULT_BIND_ADDRESS=127.0.0.1
VAULT_CLUSTER_BIND_ADDRESS=127.0.0.1

# ─── API Address ─────────────────────────────────────────────────────────────
# dev: https://127.0.0.1:8200
# prod: https://vault.your-domain.com
VAULT_API_ADDR=https://127.0.0.1:8200

# ─── Restart Policy ─────────────────────────────────────────────────────────
# dev: no | prod: unless-stopped
RESTART_POLICY=no
