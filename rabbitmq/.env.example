# RabbitMQ Environment Configuration
# Copy this file to .env.dev or .env.prod and adjust values accordingly.
# Usage:
#   docker compose --env-file .env.dev up -d
#   docker compose --env-file .env.prod up -d

# ─── Credentials ─────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=admin
# dev: simple password | prod: long random secret
RABBITMQ_DEFAULT_PASS=change-me-use-a-long-random-secret
# dev: simple cookie | prod: long random secret
RABBITMQ_ERLANG_COOKIE=change-me-use-a-long-random-secret

# ─── Bind Address ────────────────────────────────────────────────────────────
# dev: 127.0.0.1 (localhost only)
# prod: 0.0.0.0 (all interfaces, behind reverse proxy)
RABBITMQ_AMQP_BIND_ADDRESS=127.0.0.1
RABBITMQ_MANAGEMENT_BIND_ADDRESS=127.0.0.1
RABBITMQ_MQTT_BIND_ADDRESS=127.0.0.1
RABBITMQ_WEB_MQTT_BIND_ADDRESS=127.0.0.1

# ─── Timezone ────────────────────────────────────────────────────────────────
TZ=Asia/Jakarta
