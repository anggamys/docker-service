# Monitoring Stack Environment Configuration
# Copy this file to .env.dev or .env.prod and adjust values accordingly.
# Usage:
#   docker compose --env-file .env.dev up -d
#   docker compose --env-file .env.prod up -d

# ─── Grafana ─────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
# dev: simple password | prod: long random secret
GF_SECURITY_ADMIN_PASSWORD=change-me-use-a-long-random-secret

# ─── Bind Address ────────────────────────────────────────────────────────────
# dev: 127.0.0.1 (localhost only)
# prod: 0.0.0.0 (all interfaces, behind reverse proxy)
PROMETHEUS_BIND_ADDRESS=127.0.0.1
ALERTMANAGER_BIND_ADDRESS=127.0.0.1
NODE_EXPORTER_BIND_ADDRESS=127.0.0.1
CADVISOR_BIND_ADDRESS=127.0.0.1
LOKI_BIND_ADDRESS=127.0.0.1
GRAFANA_BIND_ADDRESS=127.0.0.1

# ─── Restart Policy ─────────────────────────────────────────────────────────
# dev: no | prod: unless-stopped
RESTART_POLICY=no
