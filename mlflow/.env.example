# MLflow Environment Configuration
# Copy this file to .env.dev or .env.prod and adjust values accordingly.
# Usage:
#   docker compose --env-file .env.dev up -d
#   docker compose --env-file .env.prod up -d

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=mlflow
# dev: simple password | prod: long random secret
POSTGRES_PASSWORD=change-me-use-a-long-random-secret
POSTGRES_DB=mlflow
# dev: 127.0.0.1 | prod: 0.0.0.0
POSTGRES_BIND_ADDRESS=127.0.0.1

# ─── MinIO (MLflow artifact storage) ────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
# dev: simple password | prod: long random secret
MINIO_ROOT_PASSWORD=change-me-use-a-long-random-secret
MINIO_PROMETHEUS_AUTH_TYPE=public
# dev: 127.0.0.1 | prod: 0.0.0.0
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_CONSOLE_BIND_ADDRESS=127.0.0.1

# ─── MLflow ──────────────────────────────────────────────────────────────────
# dev: 127.0.0.1 | prod: 0.0.0.0
MLFLOW_BIND_ADDRESS=127.0.0.1
# dev: localhost,127.0.0.1 | prod: your-domain.com
MLFLOW_ALLOWED_HOSTS=localhost,127.0.0.1
# dev: http://localhost:5000 | prod: https://your-domain.com
MLFLOW_CORS_ALLOWED_ORIGINS=http://localhost:5000

# ─── PostgreSQL Exporter ─────────────────────────────────────────────────────
POSTGRES_EXPORTER_USER=mlflow_postgres_exporter
# dev: simple password | prod: long random secret
POSTGRES_EXPORTER_PASS=change-me-use-a-long-random-secret
POSTGRES_EXPORTER_DB=mlflow
