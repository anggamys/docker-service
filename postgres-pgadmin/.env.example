# PostgreSQL + pgAdmin Environment Configuration
# Copy this file to .env.dev or .env.prod and adjust values accordingly.
# Usage:
#   docker compose --env-file .env.dev up -d
#   docker compose --env-file .env.prod up -d

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
# dev: simple password | prod: long random secret
POSTGRES_PASSWORD=change-me-use-a-long-random-secret
# dev: app_dev | prod: app_prod
POSTGRES_DB=app_dev
# dev: 127.0.0.1 | prod: 0.0.0.0
POSTGRES_BIND_ADDRESS=127.0.0.1

# ─── pgAdmin ─────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@admin.com
# dev: simple password | prod: long random secret
PGADMIN_DEFAULT_PASSWORD=change-me-use-a-long-random-secret
# dev: 127.0.0.1 | prod: 0.0.0.0 (behind reverse proxy)
PGADMIN_BIND_ADDRESS=127.0.0.1

# ─── Timezone ────────────────────────────────────────────────────────────────
TZ=Asia/Jakarta

# ─── PostgreSQL Exporter ─────────────────────────────────────────────────────
POSTGRES_EXPORTER_USER=postgres_exporter
# dev: simple password | prod: long random secret
POSTGRES_EXPORTER_PASS=change-me-use-a-long-random-secret
POSTGRES_EXPORTER_DB=postgres

# ─── Restart Policy ─────────────────────────────────────────────────────────
# dev: no | prod: unless-stopped
RESTART_POLICY=no
